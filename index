let cur=0;
const $=id=>document.getElementById(id);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

function renderDays(){
  $('days').innerHTML=DAYS.map((x,i)=>
    `<div class="day${i===cur?' active':''}" data-i="${i}"><div class="d">${x.d}</div><div class="m">${x.m}</div></div>`).join('');
  document.querySelectorAll('.day').forEach(el=>el.onclick=()=>{cur=+el.dataset.i;renderDays();renderDay();
    el.scrollIntoView({behavior:'smooth',inline:'center',block:'nearest'});});
}

function renderDay(){
  const D=DAYS[cur];
  $('daytitle').innerHTML=`<h2>${esc(D.t)}</h2><p>${esc(D.wd)}, ${D.d}/${D.m==='SET'?'09':'10'} · ${esc(D.s)}</p>`;
  $('timeline').innerHTML=D.items.map((it,ix)=>{
    const col=C[it.ty],bg=BG[it.ty];
    let h=`<div class="tl-item"><div class="tl-dot" style="color:${col};background:${col}"></div>`;
    h+=`<div class="card" style="background:${bg}">`;
    h+=`<div class="card-top"><span class="ctype" style="color:${col}">${LB[it.ty]}</span><span class="ctime">${esc(it.h)}</span></div>`;
    h+=`<div class="ctitle">${esc(it.ti)}</div><div class="csub">${esc(it.su)}</div>`;
    if(it.de)h+=`<div class="cdet">${esc(it.de)}</div>`;
    if(it.penalty)h+=`<div class="penalty">${esc(it.penalty)}</div>`;
    if(it.warn)h+=`<div class="warn">${esc(it.warn)}</div>`;
    if(it.tel)h+=`<a class="chip" href="tel:${it.tel}"><span class="material-icons-round">call</span>${esc(it.tel)}</a>`;
    h+=`<div class="cfoot">`;
    if(it.info)h+=`<button class="btn-info" data-d="${cur}" data-x="${ix}"><span class="material-icons-round">info</span>VER SOBRE ESTE LOCAL</button>`;
    h+=`<a class="btn-doc" href="${link(it.doc)}" target="_blank"><span class="material-icons-round">folder_open</span>Documentos</a>`;
    h+=`</div></div></div>`;
    return h;
  }).join('');
  document.querySelectorAll('.btn-info').forEach(b=>{const it=DAYS[+b.dataset.d].items[+b.dataset.x];b.onclick=()=>openSheet(it.info,it.doc);});
}

function openSheet(o,doc){
  o=Object.assign({},o);if(doc)o.doc=doc;
  $('sh-t').textContent=o.t;$('sh-s').textContent=o.s||'';
  let h='';
  (o.p||[]).forEach(p=>h+=`<p>${esc(p)}</p>`);
  if(o.d&&o.d.length){h+='<h4>Dicas práticas</h4><ul>'+o.d.map(x=>`<li>${esc(x)}</li>`).join('')+'</ul>';}
  h+='<div class="sheet-btns">';
  if(o.map)h+=`<a class="sheet-btn" target="_blank" href="https://www.google.com/maps/search/?api=1&query=${o.map}"><span class="material-icons-round">map</span>GOOGLE MAPS</a>`;
  h+=`<a class="sheet-btn" target="_blank" href="${link(o.doc)}"><span class="material-icons-round">folder_open</span>DOCUMENTOS</a>`;
  h+='</div>';
  $('sh-b').innerHTML=h;$('sheet').classList.add('on');$('sbg').classList.add('on');
}
function closeSheet(){$('sheet').classList.remove('on');$('sbg').classList.remove('on');}
$('sx').onclick=closeSheet;$('sbg').onclick=closeSheet;

