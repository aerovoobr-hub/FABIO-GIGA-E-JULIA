<title>Europa &middot; Fabio &amp; Julia</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Questrial&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
--navy:#264273;--navy-dark:#1a2f5a;--ash:#e3e2e0;--white:#fff;
--text-dark:#151e2e;--text-mid:#505878;--text-light:#9097b0;
--flight:#1a3fa0;--train:#2e7d32;--transfer:#6a1b9a;--hotel:#1b5e20;
--activity:#bf360c;--food:#b71c1c;--info:#37474f;
--r-sm:8px;--r-md:14px;--r-lg:18px;--r-xl:22px;
--sh-sm:0 1px 6px rgba(38,66,115,.07);--sh-md:0 4px 18px rgba(38,66,115,.13);
}
html{font-size:16px;-webkit-text-size-adjust:100%}
body{font-family:'Questrial',sans-serif;background:var(--ash);color:var(--text-dark);
min-height:100vh;max-width:400px;margin:0 auto;overflow-x:hidden;padding-bottom:30px}

/* HEADER */
.app-header{background:linear-gradient(160deg,#192d58 0%,#264273 55%,#2e4f8a 100%);
padding:46px 22px 0;position:sticky;top:0;z-index:100;overflow:hidden}
.app-header::before{content:'';position:absolute;inset:0;pointer-events:none;
background-image:radial-gradient(circle,rgba(255,255,255,.07) 1.5px,transparent 1.5px);
background-size:22px 22px}
.hdr-brand{text-align:center;font-family:'Montserrat',sans-serif;font-size:10.5px;
font-weight:700;letter-spacing:3.5px;color:rgba(255,255,255,.45);text-transform:uppercase;
margin-bottom:20px;position:relative}
.hdr-label{font-family:'Montserrat',sans-serif;font-size:9px;font-weight:600;
color:rgba(255,255,255,.38);letter-spacing:2px;text-transform:uppercase;margin-bottom:5px;position:relative}
.hdr-name{font-family:'Montserrat',sans-serif;font-size:25px;font-weight:800;color:#fff;
line-height:1.15;margin-bottom:10px;position:relative}
.hdr-cities{display:flex;align-items:center;gap:6px;color:rgba(255,255,255,.72);
font-size:12.5px;margin-bottom:16px;position:relative}
.hdr-cities .material-icons-round{font-size:15px}
.hdr-foot{display:flex;align-items:center;justify-content:space-between;
padding-bottom:18px;position:relative}
.hdr-dates{color:rgba(255,255,255,.62);font-size:11.5px}
.hdr-code{background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.18);
color:rgba(255,255,255,.85);font-family:'Montserrat',sans-serif;font-size:9.5px;
font-weight:700;letter-spacing:1px;padding:5px 11px;border-radius:20px}

/* TABS */
.tabbar{display:flex;background:#fff;position:sticky;top:0;z-index:99;box-shadow:var(--sh-sm)}
.tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;
padding:11px 0 9px;border:none;background:none;cursor:pointer;
border-bottom:2.5px solid transparent;transition:.15s}
.tab .material-icons-round{font-size:20px;color:var(--text-light)}
.tab span.lbl{font-family:'Montserrat',sans-serif;font-size:9.5px;font-weight:700;
letter-spacing:.8px;color:var(--text-light)}
.tab.active{border-bottom-color:var(--navy)}
.tab.active .material-icons-round,.tab.active span.lbl{color:var(--navy)}

/* DAY SELECTOR */
.days{display:flex;gap:8px;overflow-x:auto;padding:14px 16px;scrollbar-width:none}
.days::-webkit-scrollbar{display:none}
.day{flex:0 0 auto;width:52px;height:52px;border-radius:12px;background:#fff;
border:1px solid #d6d5d2;display:flex;flex-direction:column;align-items:center;
justify-content:center;cursor:pointer;transition:.15s}
.day .d{font-family:'Montserrat',sans-serif;font-size:16px;font-weight:700;color:var(--navy);line-height:1}
.day .m{font-family:'Montserrat',sans-serif;font-size:8.5px;font-weight:600;
color:var(--text-light);text-transform:uppercase;letter-spacing:.5px;margin-top:2px}
.day.active{background:var(--navy);border-color:var(--navy)}
.day.active .d,.day.active .m{color:#fff}

/* DAY TITLE */
.daytitle{padding:4px 20px 12px}
.daytitle h2{font-family:'Montserrat',sans-serif;font-size:17px;font-weight:800;color:var(--text-dark)}
.daytitle p{font-size:12.5px;color:var(--text-mid);margin-top:3px}

/* TIMELINE */
.tl{padding:0 18px}
.tl-item{position:relative;padding-left:26px;padding-bottom:14px}
.tl-item::before{content:'';position:absolute;left:5px;top:20px;bottom:-4px;width:2px;background:#d6d5d2}
.tl-item:last-child::before{display:none}
.tl-dot{position:absolute;left:0;top:8px;width:12px;height:12px;border-radius:50%;
border:2.5px solid #fff;box-shadow:0 0 0 1.5px currentColor}
.card{border-radius:var(--r-md);padding:13px 14px;box-shadow:var(--sh-sm)}
.card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:7px}
.ctype{font-family:'Montserrat',sans-serif;font-size:8.5px;font-weight:800;
letter-spacing:1.3px;text-transform:uppercase}
.ctime{font-family:'Montserrat',sans-serif;font-size:12px;font-weight:700;color:var(--text-dark)}
.ctitle{font-family:'Montserrat',sans-serif;font-size:14px;font-weight:700;
color:var(--text-dark);line-height:1.3;margin-bottom:3px}
.csub{font-size:12.5px;color:var(--text-mid);line-height:1.45}
.cdet{font-size:11.5px;color:var(--text-mid);line-height:1.5;margin-top:7px;
padding-top:7px;border-top:1px dashed rgba(0,0,0,.09)}
.chip{display:inline-flex;align-items:center;gap:5px;margin-top:9px;
background:rgba(255,255,255,.75);border:1px solid rgba(0,0,0,.07);border-radius:20px;
padding:5px 11px;font-size:11px;font-weight:600;color:var(--text-dark);text-decoration:none}
.chip .material-icons-round{font-size:14px}
.penalty{margin-top:9px;background:rgba(183,28,28,.09);border-left:3px solid #b71c1c;
border-radius:4px;padding:7px 9px;font-size:11px;color:#8e1515;line-height:1.45}
.warn{margin-top:9px;background:rgba(245,158,11,.12);border-left:3px solid #d97706;
border-radius:4px;padding:7px 9px;font-size:11px;color:#8a5a06;line-height:1.45}
.cfoot{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.btn-info{background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:20px;
padding:5px 12px;font-family:'Montserrat',sans-serif;font-size:9.5px;font-weight:700;
letter-spacing:.6px;color:var(--navy);cursor:pointer;display:inline-flex;align-items:center;gap:4px}
.btn-info .material-icons-round{font-size:13px}
.btn-doc{background:none;border:none;font-size:11px;color:var(--text-mid);
cursor:pointer;display:inline-flex;align-items:center;gap:3px;padding:5px 2px}
.btn-doc .material-icons-round{font-size:14px}

/* SHEET */
.sheet-bg{position:fixed;inset:0;background:rgba(10,18,35,.55);z-index:200;display:none}
.sheet-bg.on{display:block}
.sheet{position:fixed;left:50%;transform:translateX(-50%);bottom:0;width:100%;
max-width:400px;background:var(--ash);border-radius:22px 22px 0 0;z-index:201;
max-height:88vh;overflow-y:auto;display:none}
.sheet.on{display:block}
.sheet-hd{background:linear-gradient(160deg,#192d58,#264273);padding:20px;
border-radius:22px 22px 0 0;position:sticky;top:0}
.sheet-hd h3{font-family:'Montserrat',sans-serif;font-size:17px;font-weight:800;color:#fff;padding-right:34px}
.sheet-hd p{font-size:12px;color:rgba(255,255,255,.65);margin-top:4px}
.sheet-x{position:absolute;right:16px;top:18px;background:rgba(255,255,255,.15);
border:none;border-radius:50%;width:30px;height:30px;color:#fff;cursor:pointer;
display:flex;align-items:center;justify-content:center}
.sheet-bd{padding:18px 20px 40px}
.sheet-bd p{font-size:13px;color:var(--text-mid);line-height:1.6;margin-bottom:12px}
.sheet-bd h4{font-family:'Montserrat',sans-serif;font-size:11px;font-weight:800;
letter-spacing:1.1px;text-transform:uppercase;color:var(--navy);margin:16px 0 8px}
.sheet-bd ul{list-style:none}
.sheet-bd li{font-size:12.5px;color:var(--text-mid);line-height:1.55;
padding-left:15px;position:relative;margin-bottom:7px}
.sheet-bd li::before{content:'';position:absolute;left:0;top:7px;width:5px;height:5px;
border-radius:50%;background:var(--navy);opacity:.5}
.sheet-btns{display:flex;gap:8px;margin-top:18px;flex-wrap:wrap}
.sheet-btn{flex:1;min-width:110px;background:var(--navy);color:#fff;text-decoration:none;
border-radius:var(--r-sm);padding:11px;text-align:center;font-family:'Montserrat',sans-serif;
font-size:10.5px;font-weight:700;letter-spacing:.5px;display:flex;align-items:center;
justify-content:center;gap:5px}
.sheet-btn .material-icons-round{font-size:15px}

/* GENERIC PANEL */
.panel{padding:16px 18px 10px}
.sect{font-family:'Montserrat',sans-serif;font-size:10.5px;font-weight:800;
letter-spacing:1.4px;text-transform:uppercase;color:var(--text-light);margin:20px 2px 10px}
.row{display:flex;align-items:center;gap:12px;background:#fff;border-radius:var(--r-md);
padding:13px 14px;margin-bottom:9px;box-shadow:var(--sh-sm);text-decoration:none;color:inherit}
.row-ic{flex:0 0 auto;width:38px;height:38px;border-radius:10px;display:flex;
align-items:center;justify-content:center;color:#fff}
.row-ic .material-icons-round{font-size:19px}
.row-tx{flex:1;min-width:0}
.row-tx .t{font-family:'Montserrat',sans-serif;font-size:12.5px;font-weight:700;color:var(--text-dark)}
.row-tx .s{font-size:11.5px;color:var(--text-mid);margin-top:2px;word-break:break-word}
.row-go{flex:0 0 auto;width:26px;height:26px;border-radius:50%;background:var(--ash);
display:flex;align-items:center;justify-content:center;color:var(--navy)}
.row-go .material-icons-round{font-size:16px}

/* HERO CONSULTANT */
.hero{background:linear-gradient(160deg,#192d58,#264273);border-radius:var(--r-lg);
padding:22px;color:#fff;box-shadow:var(--sh-md);margin-bottom:6px}
.hero .lb{font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;
letter-spacing:2px;color:rgba(255,255,255,.45);text-transform:uppercase}
.hero h3{font-family:'Montserrat',sans-serif;font-size:20px;font-weight:800;margin:6px 0 3px}
.hero p{font-size:12.5px;color:rgba(255,255,255,.7);margin-bottom:16px}
.hero-btns{display:flex;gap:8px}
.hero-btn{flex:1;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.2);
border-radius:var(--r-sm);padding:10px;text-align:center;text-decoration:none;color:#fff;
font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;letter-spacing:.5px;
display:flex;flex-direction:column;align-items:center;gap:4px}
.hero-btn .material-icons-round{font-size:17px}

.note{background:#fff;border-left:3px solid var(--navy);border-radius:var(--r-sm);
padding:12px 14px;font-size:12px;color:var(--text-mid);line-height:1.55;
margin-bottom:10px;box-shadow:var(--sh-sm)}
.note b{color:var(--text-dark)}
.hide{display:none}
</style>
</head>
